# Backend
PORT=3001
NODE_ENV=development

# Frontend
# Leave empty when using the same origin or the Vite /api proxy.
VITE_API_BASE_URL=

# Database / secrets
# Recommended: Neon Postgres through the Vercel Marketplace.
# Example format only. Do not commit a real URL.
DATABASE_URL=
# Some Vercel/Neon integrations may expose POSTGRES_URL instead.
POSTGRES_URL=

# Neon/Vercel Marketplace may prefix environment variables with the store name.
Agency_hub_DATABASE_URL=
Agency_hub_POSTGRES_URL=
